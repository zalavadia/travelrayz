# TRAVELRAYZ — clean URLs, HTTPS + apex (no www)

Options -MultiViews
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Force apex (redirect www → non-www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Legacy short paths → nav-matched URLs
RewriteRule ^trips/?$ /explore-trips [R=301,L,QSA]
RewriteRule ^about/?$ /our-story [R=301,L,QSA]
RewriteRule ^gallery/?$ /captured-journeys [R=301,L,QSA]
RewriteRule ^testimonials/?$ /travel-stories [R=301,L,QSA]
RewriteRule ^contact/?$ /lets-connect [R=301,L,QSA]
RewriteRule ^upcoming-trips/?$ /explore-trips [R=301,L,QSA]

# Strip trailing slash (except root)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve folder/index.html for extensionless paths
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ $1/index.html [L]
