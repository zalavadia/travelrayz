# TRAVELRAYZ — clean URLs without trailing slash (Hostinger / Apache)

Options -MultiViews
RewriteEngine On
RewriteBase /

# Legacy short paths → nav-matched URLs
RewriteRule ^trips/?$ /explore-trips [R=301,L,QSA]
RewriteRule ^about/?$ /our-story [R=301,L,QSA]
RewriteRule ^gallery/?$ /captured-journeys [R=301,L,QSA]
RewriteRule ^testimonials/?$ /travel-stories [R=301,L,QSA]
RewriteRule ^contact/?$ /lets-connect [R=301,L,QSA]
RewriteRule ^upcoming-trips/?$ /explore-trips [R=301,L,QSA]

# Strip trailing slash (except root)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve folder/index.html for extensionless paths
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ $1/index.html [L]
